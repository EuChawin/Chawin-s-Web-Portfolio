# ============================================================
# .env.local — Environment Variables
# NEVER commit this file to git. It is listed in .gitignore.
# ============================================================

# ─── SUPABASE: FRONTEND-SAFE ────────────────────────────────────────
# These are safe to expose to the browser (prefixed with NEXT_PUBLIC_)
# RLS policies are your security layer — not key secrecy

# Your Supabase project URL (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Public anon key (Dashboard → Settings → API → anon public)
# This key is safe for the browser — RLS protects all your data
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SUPABASE: SERVER-SIDE ONLY ─────────────────────────────────────
# ⚠️  WARNING: This key bypasses ALL Row Level Security.
# ⚠️  ONLY use in Route Handlers (/app/api/**) or Server Actions.
# ⚠️  NEVER put this in any 'use client' component or hook.
# (Dashboard → Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SITE CONFIGURATION ─────────────────────────────────────────────
# Used for OG tags, canonical URLs, sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your name / site title
NEXT_PUBLIC_SITE_NAME=Your Name

# ─── GITHUB OAUTH (for Admin CMS login) ─────────────────────────────
# Configure in: Supabase Dashboard → Authentication → Providers → GitHub
# Then in GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:    http://localhost:3000
#   Callback URL:    http://localhost:3000/auth/callback
# No env vars needed here — all configured in Supabase Dashboard

# ─── FUTURE: AI FEATURES (server-side only) ─────────────────────────
# Uncomment when implementing AI features
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── FUTURE: EMAIL (server-side only) ───────────────────────────────
# For contact form processing
# RESEND_API_KEY=re_...
# CONTACT_FORM_TO_EMAIL=you@example.com
